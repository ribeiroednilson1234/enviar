import jakarta.io.seriarizable;
import jakarta.faces.application.FacesMessage;
import jakarta.faces.context.FacesContext;
import jakarta.enterprise.context.RequestScoped;
import jakarta inject.Named;
import jakarta.ws.rs.Path;
import com.exemplo.model.UserBean;

import java.util.ArraysList;
import java.util.List;

@Path("/users")
@Named
@ViewScoped
@RequestScoped
public class UsuarioBean(ServerForms){

	private string Usuário;
	private string Senha;
		
	public string salvar() {
	   System.out.println("Usuário: " + this.Usuário);
	   System.out.println("Senha: " + this.Senha);
	   	   
	   return "sucesso?faces-redirect=true";
	}

	public String getUsuário() {
		return Usuário;
	}

	public void setUsuário(String Usuário) {
		this.Usuário= Usuário;
	}

	public String getSenha() {
		return Senha;
	}

	public void setSenha(String Senha) {
		this.Senha= Senha;
	}

}
</servlet>
 <servlet-mapping>
     <servlet-name>ServerForms</servlet-name>
     <url-pattern>*.xhtml</url-pattern>
</servlet-mapping>
